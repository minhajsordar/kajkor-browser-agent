{
  "name": "browser-agent-desktop",
  "version": "1.0.0",
  "description": "Kajkor Agent — chat-first desktop app: embeds the Express backend and drives the Chrome extension executor.",
  "main": "./out/main/index.js",
  "author": "minhajsordar.com",
  "homepage": "https://minhajsordar.com",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck": "npm run typecheck:node",
    "build-server": "esbuild ../backend/server.js --bundle --platform=node --target=node20 --outfile=resources/server/server.cjs --format=cjs --external:mongodb-client-encryption --external:aws4 --external:kerberos --external:@mongodb-js/zstd --external:snappy --external:bson-ext --external:gcp-metadata --external:socks --external:@aws-sdk/*",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "prebuild": "npm run build-server",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "axios": "^1.15.2",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@huggingface/transformers": "^4.2.0",
    "@quasar/extras": "^1.16.12",
    "@quasar/vite-plugin": "^1.7.0",
    "@types/node": "^22.16.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^37.2.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.31.0",
    "pinia": "^2.2.4",
    "prettier": "^3.6.2",
    "quasar": "^2.17.0",
    "sass-embedded": "^1.80.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.5",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  }
}
