{
  "name": "browser-agent-backend",
  "version": "0.2.0",
  "description": "Backend for Browser Agent. Stores collected data in MongoDB.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:api": "node test/run-api.js",
    "dump": "node backup.js dump",
    "restore": "node backup.js restore"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.5.0"
  }
}
